# Copy to .env (it is git-ignored). Never commit real keys.
# Marsadix reads this file ITSELF and keeps the keys in memory; they are NOT exported to the
# tools it starts. Real environment variables (CI, Docker --env-file) override this file.
# Protect it: chmod 600 .env   (Windows: keep it out of shared/synced folders)
# Any key left empty here is SKIPPED, not an error (see core/config.py).

# --- CVE sources ---
NVD_API_KEY=

# --- Recon data sources (R2) ---
SHODAN_API_KEY=
CENSYS_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
CHAOS_API_KEY=

# --- Alert channels (M12, M14, M18) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
